{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pantheon",
  "version": "0.2.6",
  "identifier": "dev.kitty.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-dictation-pack.ps1 && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Pantheon",
        "width": 1040,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://pantheon.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/dictation/": "dictation/",
      "resources/vc-runtime/msvcp140.dll": "msvcp140.dll",
      "resources/vc-runtime/msvcp140_1.dll": "msvcp140_1.dll",
      "resources/vc-runtime/vcruntime140.dll": "vcruntime140.dll",
      "resources/vc-runtime/vcruntime140_1.dll": "vcruntime140_1.dll",
      "../docs/licenses/VC-Runtime-NOTICE.txt": "VC-Runtime-NOTICE.txt"
    },
    "publisher": "goujandev",
    "shortDescription": "Your personal hub for AI coding agents.",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4ODhBOTc2RUQzRDk5ODIKUldTQ21UM3RkcW1JV0Jid2ZyTndPYnhhVkwyZmptK2R4aG9RVytna0dxbHdtWkdmOHNobFE3b2EK",
      "endpoints": [
        "https://github.com/goujandev/kitty/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
