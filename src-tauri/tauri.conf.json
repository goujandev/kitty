{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kitty",
  "version": "0.2.0",
  "identifier": "dev.kitty.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kitty",
        "width": 1040,
        "height": 760,
        "minWidth": 560,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: http://kitty.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "goujandev",
    "shortDescription": "A desktop workspace for your coding agents.",
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4ODhBOTc2RUQzRDk5ODIKUldTQ21UM3RkcW1JV0Jid2ZyTndPYnhhVkwyZmptK2R4aG9RVytna0dxbHdtWkdmOHNobFE3b2EK",
      "endpoints": [
        "https://github.com/goujandev/kitty/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
